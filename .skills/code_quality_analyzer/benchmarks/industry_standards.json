{
  "version": "1.0",
  "last_updated": "2025-10-22",
  "description": "Industry standard benchmarks for Python code quality metrics",

  "cyclomatic_complexity": {
    "per_function": {
      "excellent": {"min": 1, "max": 5, "description": "Simple, low risk"},
      "good": {"min": 6, "max": 10, "description": "Moderate complexity, manageable"},
      "fair": {"min": 11, "max": 20, "description": "Complex, consider refactoring"},
      "poor": {"min": 21, "max": 50, "description": "High risk, refactor urgently"},
      "critical": {"min": 51, "max": 999, "description": "Extremely high risk, immediate refactoring required"}
    },
    "project_average": {
      "excellent": {"min": 1, "max": 3, "description": "Very maintainable codebase"},
      "good": {"min": 3.1, "max": 6, "description": "Maintainable codebase"},
      "fair": {"min": 6.1, "max": 10, "description": "Needs attention"},
      "poor": {"min": 10.1, "max": 999, "description": "Significant refactoring needed"}
    }
  },

  "function_length": {
    "lines_of_code": {
      "excellent": {"min": 1, "max": 20, "description": "Optimal size"},
      "good": {"min": 21, "max": 50, "description": "Acceptable size"},
      "fair": {"min": 51, "max": 100, "description": "Consider splitting"},
      "poor": {"min": 101, "max": 200, "description": "Refactoring recommended"},
      "critical": {"min": 201, "max": 9999, "description": "Must be refactored"}
    }
  },

  "maintainability_index": {
    "scale": "0-100, higher is better",
    "excellent": {"min": 85, "max": 100, "description": "Excellent maintainability"},
    "good": {"min": 65, "max": 84, "description": "Good maintainability"},
    "fair": {"min": 40, "max": 64, "description": "Moderate, needs attention"},
    "poor": {"min": 20, "max": 39, "description": "Poor, refactoring recommended"},
    "critical": {"min": 0, "max": 19, "description": "Critical issues, immediate refactoring required"}
  },

  "documentation_coverage": {
    "docstring_percentage": {
      "excellent": {"min": 90, "max": 100, "description": "Excellent documentation"},
      "good": {"min": 70, "max": 89, "description": "Good documentation"},
      "fair": {"min": 50, "max": 69, "description": "Needs improvement"},
      "poor": {"min": 25, "max": 49, "description": "Poor documentation"},
      "critical": {"min": 0, "max": 24, "description": "Severely lacking documentation"}
    }
  },

  "comment_ratio": {
    "percentage": {
      "too_low": {"min": 0, "max": 5, "description": "Insufficient comments"},
      "low": {"min": 5, "max": 10, "description": "Could use more comments"},
      "optimal": {"min": 10, "max": 30, "description": "Good balance"},
      "high": {"min": 30, "max": 50, "description": "Possibly over-commented"},
      "too_high": {"min": 50, "max": 100, "description": "Excessive comments, may indicate code clarity issues"}
    }
  },

  "class_metrics": {
    "methods_per_class": {
      "excellent": {"min": 1, "max": 7, "description": "Well-focused class"},
      "good": {"min": 8, "max": 15, "description": "Acceptable complexity"},
      "fair": {"min": 16, "max": 30, "description": "Consider breaking up"},
      "poor": {"min": 31, "max": 9999, "description": "Too many responsibilities"}
    },
    "attributes_per_class": {
      "excellent": {"min": 1, "max": 5, "description": "Simple state management"},
      "good": {"min": 6, "max": 10, "description": "Moderate complexity"},
      "fair": {"min": 11, "max": 20, "description": "Complex state"},
      "poor": {"min": 21, "max": 9999, "description": "Overly complex"}
    }
  },

  "file_metrics": {
    "lines_per_file": {
      "excellent": {"min": 1, "max": 250, "description": "Well-sized module"},
      "good": {"min": 251, "max": 500, "description": "Acceptable size"},
      "fair": {"min": 501, "max": 1000, "description": "Large file, consider splitting"},
      "poor": {"min": 1001, "max": 9999, "description": "Too large, refactor into multiple files"}
    },
    "functions_per_file": {
      "excellent": {"min": 1, "max": 10, "description": "Focused module"},
      "good": {"min": 11, "max": 20, "description": "Moderate module"},
      "fair": {"min": 21, "max": 40, "description": "Large module"},
      "poor": {"min": 41, "max": 9999, "description": "Too many functions, split module"}
    }
  },

  "code_smells": {
    "god_function": {
      "threshold": 50,
      "description": "Function doing too many things (>50 lines)"
    },
    "god_class": {
      "method_threshold": 20,
      "description": "Class with too many methods"
    },
    "deep_nesting": {
      "threshold": 4,
      "description": "More than 4 levels of indentation"
    },
    "too_many_parameters": {
      "threshold": 5,
      "description": "Function with more than 5 parameters"
    }
  },

  "best_practices": {
    "python_specific": [
      "Follow PEP 8 style guide",
      "Use type hints for function signatures",
      "Write comprehensive docstrings (Google or NumPy style)",
      "Keep functions under 20 lines when possible",
      "Limit cyclomatic complexity to 10 or below",
      "Use list comprehensions for simple transformations",
      "Avoid mutable default arguments",
      "Use context managers for resource management"
    ],
    "general": [
      "Single Responsibility Principle: Each function/class should do one thing",
      "DRY (Don't Repeat Yourself): Extract common code",
      "KISS (Keep It Simple): Prefer simple solutions",
      "Meaningful names: Use descriptive variable and function names",
      "Early returns: Reduce nesting with guard clauses",
      "Error handling: Use specific exception types",
      "Testing: Aim for >80% test coverage"
    ]
  },

  "severity_levels": {
    "critical": {
      "color": "red",
      "symbol": "✗",
      "action": "Immediate refactoring required"
    },
    "poor": {
      "color": "orange",
      "symbol": "⚠",
      "action": "Refactoring recommended soon"
    },
    "fair": {
      "color": "yellow",
      "symbol": "⚡",
      "action": "Consider improvements"
    },
    "good": {
      "color": "green",
      "symbol": "✓",
      "action": "Acceptable quality"
    },
    "excellent": {
      "color": "green",
      "symbol": "✓✓",
      "action": "Excellent quality"
    }
  }
}
